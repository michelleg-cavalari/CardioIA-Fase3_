#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <DHT.h>

#define DHTPIN 15
#define DHTTYPE DHT22

DHT dht(DHTPIN, DHTTYPE);

// Wi-Fi do Wokwi
const char* ssid = "Wokwi-GUEST";
const char* password = "";

// HiveMQ Cloud
const char* mqtt_server = "9bcb2d26d57a467b812de9b24114563e.s1.eu.hivemq.cloud";
const int mqtt_port = 8883;

const char* mqtt_user = "cardioia";
const char* mqtt_pass = "CardioIA123";

WiFiClientSecure espClient;
PubSubClient client(espClient);

void setup_wifi() {
  Serial.print("Conectando WiFi");

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi conectado!");
}

void reconnect() {
  while (!client.connected()) {
    Serial.print("Conectando MQTT...");

    String clientId = "CardioIA_ESP32_" + String(random(0xffff), HEX);

    if (client.connect(clientId.c_str(), mqtt_user, mqtt_pass)) {
      Serial.println("conectado!");
    } else {
      Serial.print("falhou, rc=");
      Serial.println(client.state());
      delay(3000);
    }
  }
}

void setup() {
  Serial.begin(115200);
  dht.begin();

  setup_wifi();

  espClient.setInsecure(); // usado para facilitar TLS no simulador
  client.setServer(mqtt_server, mqtt_port);
  client.setKeepAlive(60);
  client.setSocketTimeout(15);

  randomSeed(analogRead(0));
}

void loop() {
  if (!client.connected()) {
    reconnect();
  }

  client.loop();

  // Simulação automática dos sinais vitais
  float temperatura = random(360, 395) / 10.0; // 36.0 a 39.5
  int umidade = random(35, 80);                // 35% a 80%
  int bpm = random(45, 145);                   // 45 a 145 bpm

  String alerta = "Paciente dentro dos parametros normais";

  if (temperatura > 38) {
    alerta = "ALERTA: Temperatura alta";
  }

  if (bpm > 120) {
    alerta = "ALERTA: Batimentos elevados";
  }

  if (bpm < 50) {
    alerta = "ALERTA: Batimentos muito baixos";
  }

  // Publicação MQTT
  client.publish("cardioia/temperatura", String(temperatura).c_str());
  client.publish("cardioia/umidade", String(umidade).c_str());
  client.publish("cardioia/bpm", String(bpm).c_str());
  client.publish("cardioia/alerta", alerta.c_str());

  // Monitor Serial
  Serial.println("===== CARDIOIA MQTT =====");

  Serial.print("Temperatura: ");
  Serial.print(temperatura);
  Serial.println(" C");

  Serial.print("Umidade: ");
  Serial.print(umidade);
  Serial.println(" %");

  Serial.print("BPM: ");
  Serial.println(bpm);

  Serial.print("Status: ");
  Serial.println(alerta);

  Serial.println("Dados enviados via MQTT");
  Serial.println("=========================");

  delay(5000);
}
